root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true
spelling-language = en-gb
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8

[*.sh]
indent_size = 4
simplify = true
binary_next_line = true
switch_case_indent = true
space_redirects = true

[*.{py,c,cc,cpp,h,hpp}]
indent_size = 4

[{.js,jsx,mjs,cjs,ts,tsx,package.json,.travis.yml}]
indent_size = 2

[*.{nix,toml,yml,yaml,json,jsonc,json5,html,css,scss,sass,less}]
indent_size = 2

[{[Dd]ockerfile*,[Cc]ontainerfile*,*.dockerfile}]
indent_size = 4

[*.{md,mdx}]
indent_size = 2
trim_trailing_whitespace = false

# enforced
[{[Mm]akefile,GNUmakefile}]
indent_style = tab
indent_size = 2

[*.lua]
indent_size = 2

# enforced
[*.go]
indent_style = tab
indent_size = 4
tab_width = 4
